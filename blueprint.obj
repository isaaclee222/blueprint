# Blueprint — Smart Building Sketch, prototype 0.3.10
# Wavefront OBJ export · units: meters · Y is up (plan x -> -X, plan y -> -Z)
# floors: 1 · floor height 3 m · slab 0.2 m · half walls 1 m
# Each room is emitted as its own OBJ object: F1_Room_1, F1_Room_2, etc.
# Shared room-to-room walls are emitted once; wall editing is permissive for tracing real plans.
# Wall ends/junctions are capped/trimmed for flush interior and exterior corners.
# Doors are exported as 45-degree open panels; pillars export as full-height supports.
# Materials are exported to blueprint.mtl; keep the .obj and .mtl in the same folder.
# UVs are procedural and use 1 texture tile per meter for wall/floor alignment tests.
# Exact hidden coplanar faces between touching boxes are culled during export.
mtllib blueprint.mtl

vn 0 0 -1
vn 0 0 1
vn 0 -1 0
vn 1 0 0
vn 0 1 0
vn -1 0 0


